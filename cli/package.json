{
  "name": "cli",
  "version": "0.2.0",
  "license": "GPL-3.0",
  "author": "SutuLabs",
  "scripts": {
    "dev": "nodemon server.ts",
    "build": "ncc build server.ts -o dist/cli && cp ../node_modules/clvm/browser/blsjs.wasm dist/cli",
    "build:docker": "yarn build && docker build -f Dockerfile -t wizicer/coin-processor:latest .",
    "start": "cross-env MAX_THREAD=0 ts-node server.ts",
    "importmods": "ts-node importmods.ts",
    "compile": "ts-node compile.ts",
    "brun": "ts-node brun.ts",
    "publish:docker": "docker push wizicer/coin-processor:latest",
    "test": "jest --coverage=false"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/supertest": "^2.0.12",
    "@vercel/ncc": "^0.34.0",
    "clvm_tools": "^0.9.5",
    "cross-env": "^7.0.3",
    "cross-fetch": "^3.1.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "glob": "^10.2.2",
    "jest": "^28.1.1",
    "nodemon": "^2.0.19",
    "supertest": "^6.2.4",
    "ts-jest": "^28.0.5",
    "ts-node": "^10.8.1",
    "typescript": "^4.9"
  }
}
